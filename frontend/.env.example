# Copy to .env.local in this folder and paste the same Web client ID used by the API.
# Restart `npm run dev` after changing this file.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Website Sign in with Apple. Leave unset to use com.zipdeck.web.
# The Android app does not show this button.
# VITE_APPLE_CLIENT_ID=com.zipdeck.web

# Leave empty for web (same-origin /api). Android builds set this in .env.android.
VITE_API_BASE=

# PostHog project token (write-only, safe in the client). US Cloud.
VITE_POSTHOG_KEY=phc_yeSHD4zZb2ttaiX6skWnwPmM3AA7Rptbt48w92rWGHzP
