# Copy to .env.android (gitignored). Used by `npm run build:android` and iOS sync.
# Native WebView origin is https://zipdeck.app / capacitor://zipdeck.app. The API
# must be a different host or Capacitor will serve /api from the bundled app.
VITE_API_BASE=https://api.zipdeck.app

# Same Web OAuth client ID as the website / API. Native Google Sign-In still uses this
# as the ID token audience. Also create an Android OAuth client for com.zipdeck.app.
# VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Do not set VITE_APPLE_CLIENT_ID. Sign in with Apple stays off the Android app.

# PostHog project token. Same key as the website.
VITE_POSTHOG_KEY=phc_yeSHD4zZb2ttaiX6sklwnPmM3AA7Rptbt48w92rWGHZP
