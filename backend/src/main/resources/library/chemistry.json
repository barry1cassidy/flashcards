        {
          "slug": "periodic-table-groups",
          "name": "Periodic Table Groups",
          "description": "Families, periods, and what the table is organized by.",
          "position": 2,
          "cards": [
            {
              "front": "Rows of the periodic table are called",
              "back": "periods"
            },
            {
              "front": "Columns of the periodic table are called",
              "back": "groups (or families)"
            },
            {
              "front": "Elements are arranged by",
              "back": "increasing atomic number"
            },
            {
              "front": "Atomic number is",
              "back": "the number of protons"
            },
            {
              "front": "Mass number is",
              "back": "protons plus neutrons"
            },
            {
              "front": "Group 1 elements are",
              "back": "alkali metals"
            },
            {
              "front": "Group 2 elements are",
              "back": "alkaline earth metals"
            },
            {
              "front": "Group 17 elements are",
              "back": "halogens"
            },
            {
              "front": "Group 18 elements are",
              "back": "noble gases"
            },
            {
              "front": "Metals are mostly found",
              "back": "on the left and in the center"
            },
            {
              "front": "Nonmetals are mostly found",
              "back": "on the right"
            },
            {
              "front": "Metalloids sit",
              "back": "along the stair-step line"
            },
            {
              "front": "Noble gases are known for being",
              "back": "mostly unreactive"
            },
            {
              "front": "Alkali metals are known for being",
              "back": "very reactive (especially with water)"
            },
            {
              "front": "Halogens are known for being",
              "back": "reactive nonmetals that form salts"
            },
            {
              "front": "The lanthanides and actinides are",
              "back": "the two rows shown below the main table"
            },
            {
              "front": "A valence electron is",
              "back": "an electron in the outer shell"
            },
            {
              "front": "Elements in the same group often have",
              "back": "similar chemical properties"
            },
            {
              "front": "Hydrogen is unusual because",
              "back": "it is a nonmetal placed above the alkali metals"
            },
            {
              "front": "What is an isotope?",
              "back": "Atoms of the same element with different neutron counts"
            }
          ]
        },
        {
          "slug": "chemistry-vocab",
          "name": "Chemistry Vocabulary",
          "description": "Atoms, bonds, and everyday lab words.",
          "position": 3,
          "cards": [
            {
              "front": "An atom is",
              "back": "the smallest unit of an element that still is that element"
            },
            {
              "front": "A molecule is",
              "back": "two or more atoms bonded together"
            },
            {
              "front": "A compound is",
              "back": "a substance made of two or more elements bonded in a fixed ratio"
            },
            {
              "front": "A mixture keeps",
              "back": "the identities of its parts (not a fixed formula)"
            },
            {
              "front": "A proton has charge",
              "back": "positive"
            },
            {
              "front": "An electron has charge",
              "back": "negative"
            },
            {
              "front": "A neutron has charge",
              "back": "none (neutral)"
            },
            {
              "front": "Where are protons and neutrons?",
              "back": "in the nucleus"
            },
            {
              "front": "Where are electrons?",
              "back": "outside the nucleus (electron cloud)"
            },
            {
              "front": "An ion is",
              "back": "an atom or group with a charge"
            },
            {
              "front": "A cation is",
              "back": "a positive ion"
            },
            {
              "front": "An anion is",
              "back": "a negative ion"
            },
            {
              "front": "An ionic bond forms when",
              "back": "electrons are transferred (metal + nonmetal, typically)"
            },
            {
              "front": "A covalent bond forms when",
              "back": "electrons are shared (often two nonmetals)"
            },
            {
              "front": "pH below 7 is",
              "back": "acidic"
            },
            {
              "front": "pH of 7 is",
              "back": "neutral"
            },
            {
              "front": "pH above 7 is",
              "back": "basic (alkaline)"
            },
            {
              "front": "A physical change",
              "back": "does not make a new substance"
            },
            {
              "front": "A chemical change",
              "back": "makes a new substance"
            },
            {
              "front": "A catalyst",
              "back": "speeds a reaction without being used up"
            },
            {
              "front": "The law of conservation of mass says",
              "back": "mass is not created or destroyed in a chemical change"
            }
          ]
        }
      ]
