        {
          "slug": "rhetorical-moves",
          "name": "Rhetorical Moves",
          "description": "What a sentence is doing in a passage.",
          "position": 0,
          "cards": [
            {
              "front": "A claim is",
              "back": "the point the writer wants you to accept"
            },
            {
              "front": "Evidence is",
              "back": "facts, data, or examples that support a claim"
            },
            {
              "front": "Reasoning is",
              "back": "the explanation that links evidence to the claim"
            },
            {
              "front": "A counterclaim is",
              "back": "an opposing point the writer acknowledges"
            },
            {
              "front": "A concession admits",
              "back": "that the other side has a valid point"
            },
            {
              "front": "A rebuttal answers",
              "back": "the counterclaim"
            },
            {
              "front": "To synthesize is to",
              "back": "combine ideas from more than one place"
            },
            {
              "front": "A topic sentence usually",
              "back": "states the paragraph’s main idea"
            },
            {
              "front": "A concluding sentence often",
              "back": "wraps up or points forward"
            },
            {
              "front": "Tone is",
              "back": "the writer’s attitude toward the subject"
            },
            {
              "front": "Purpose is",
              "back": "why the text was written (inform, persuade, explain)"
            },
            {
              "front": "Audience is",
              "back": "who the writer expects to read the text"
            },
            {
              "front": "A summary restates",
              "back": "the main ideas in fewer words"
            },
            {
              "front": "A paraphrase restates",
              "back": "an idea in new words at a similar length"
            },
            {
              "front": "To evaluate an argument, ask",
              "back": "whether the evidence actually supports the claim"
            },
            {
              "front": "A generalization may be weak if",
              "back": "it is based on too few examples"
            },
            {
              "front": "Word choice (diction) affects",
              "back": "tone and precision"
            },
            {
              "front": "A transition should match",
              "back": "the logical link between two ideas"
            }
          ]
        },
