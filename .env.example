# Copy to .env in the repo root (gitignored) before `docker compose -f docker-compose.prod.yml up`.
MYSQL_DATABASE=flashcards
MYSQL_USER=flashcards
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# At least 32 random characters. Example: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string
# Optional. Same Web client ID as local Google sign-in.
GOOGLE_CLIENT_ID=
# Comma-separated. Capacitor WebView origins must be listed for the Android app to call this API.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost,https://localhost,capacitor://localhost
