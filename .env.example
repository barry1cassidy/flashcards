# Copy to .env in the repo root (gitignored) before `docker compose -f docker-compose.prod.yml up`.
MYSQL_DATABASE=flashcards
MYSQL_USER=flashcards
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# At least 32 random characters. Example: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string
# Optional. Same Web client ID as local Google sign-in.
GOOGLE_CLIENT_ID=
# Comma-separated. Capacitor WebView origins must be listed for the Android app to call this API.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost,https://localhost,capacitor://localhost,capacitor://zipdeck.app,https://zipdeck.app,https://www.zipdeck.app
# Optional. Gemini (or other OpenAI-compatible) key for Create With AI. Leave empty to disable.
AGENT_API_KEY=
# Optional. Override the Gemini defaults in application.yml.
AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_MODEL=gemini-3.8-flash
# Stripe test keys first. Leave empty until you have a Stripe account.
# The API still starts; Settings hides Subscribe until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_ADDON=
APP_PUBLIC_URL=https://zipdeck.app
APP_BILLING_STUB_ENABLED=false
# false = everyone sees Pro features, only admins can subscribe or stub-toggle Pro.
APP_BILLING_PUBLIC_CHECKOUT=false
# Card images. Local disk in the API container, or a private Lightsail/S3 bucket.
# Lightsail: bucket Permissions → Access keys (do not enable “Host a static website”).
CARD_IMAGES_STORAGE=s3
CARD_IMAGES_S3_BUCKET=zipdeck-card-images
CARD_IMAGES_S3_REGION=us-west-2
CARD_IMAGES_S3_PREFIX=card-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
